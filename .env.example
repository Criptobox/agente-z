# ─────────────────────────────────────────────────────────────────
# Variables de entorno para desarrollo local.
# En GitHub Actions estas vars las inyecta el workflow automáticamente.
# Copia este archivo a .env y rellena solo lo que vayas a usar.
# ─────────────────────────────────────────────────────────────────

# Token de GitHub. Local: crea un PAT con repo + models:read.
# En Actions: lo inyecta el workflow desde secrets.GITHUB_TOKEN.
GITHUB_TOKEN=

# Repo donde vive este sistema (formato owner/name).
# En Actions: ${GITHUB_REPOSITORY}
GITHUB_REPOSITORY=

# Proyecto externo que los agentes van a analizar.
# Formato: owner/name. Si hay varios, sepáralos por coma.
TARGET_REPOS=tiendamax/tiendamax-web

# ── Modelo primario (GitHub Models) ──
# Lista de modelos en orden de preferencia. El router cae al siguiente si el primario falla.
# Ver catálogo: https://github.com/marketplace/models
MODELS_PRIMARY=gpt-4o-mini
MODELS_FALLBACK=phi-3-mini-4k-instruct

# Modelo de embeddings (mismo catálogo).
EMBEDDINGS_MODEL=text-embedding-3-small

# ── Endpoints alternativos (opcionales, solo si te sales del tier gratis) ──
# Groq gratis: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Google Gemini free tier
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── Presupuesto global del sistema ──
# Tokens por día. Cuando se acerca al 80%, el agente budget avisa.
# Cuando llega al 100%, mata tareas en cola.
BUDGET_DAILY_TOKENS=120000
BUDGET_DAILY_ACTIONS_MINUTES=180
# Nivel de aviso (0-100). A partir de aquí el diarista te lo cuenta en el Issue.
BUDGET_WARN_PERCENT=80

# ── Idioma y región ──
LOCALE=es
TIMEZONE=America/Havana

# ── Tools web (web_search, web_fetch) ──
# Habilitadas por defecto; pon false para desactivar el acceso a internet de los agentes.
# El acceso real lo limita el sistema de permisos por agente (permiso 'web' en su .md).
WEB_ENABLED=true
# Límite de descarga por URL de web_fetch, en bytes (default 50000).
WEB_FETCH_MAX_BYTES=50000

# ── Inferencia local (Ollama / llama.cpp server, API compatible OpenAI) ──
OLLAMA_ENDPOINT=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b
# Solo si tu server local pide Bearer token (ej. llama.cpp --api-key).
OLLAMA_KEY=

# ── Modo debug ──
# DRY_RUN=1 hace que runner.js no llame a la API de inferencia y use respuestas mockeadas.
DRY_RUN=0
